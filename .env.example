# ============================================================
# NEXUS//OS — environment variables (Phase 2: real integrations)
# The demo (standalone/ and src/) needs NONE of these.
# Copy this file to .env and fill in real values when connecting
# live services. NEVER commit .env to git.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Webhook security ---
# Random secret used to verify WooCommerce webhook HMAC signatures
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- WooCommerce (WordPress admin → WooCommerce → Settings → Advanced → REST API) ---
WOOCOMMERCE_STORE_URL=https://yourstore.example.com
WOOCOMMERCE_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- WordPress REST API (Users → Profile → Application Passwords) ---
WP_USER=your-admin-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- OpenAI (https://platform.openai.com/api-keys) ---
# gpt-4o-mini keeps cost at fractions of a cent per query
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Telegram notifications (create a bot via @BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=your-numeric-chat-id

# --- Supabase / PostgreSQL (https://supabase.com — free tier) ---
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# or a plain Postgres connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/nexusos

# --- Google Analytics 4 Data API (service account JSON path) ---
GA4_PROPERTY_ID=123456789
GOOGLE_APPLICATION_CREDENTIALS=./keys/ga4-service-account.json

# --- Meta Graph API (developers.facebook.com — free, business account) ---
META_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxx
META_IG_USER_ID=17841400000000000

# --- TikTok Business API (business-api.tiktok.com) ---
TIKTOK_ACCESS_TOKEN=

# --- Automation (Zapier / Make / n8n webhook endpoints) ---
ZAPIER_ORDER_WEBHOOK=https://hooks.zapier.com/hooks/catch/000000/xxxxxx/
N8N_WEBHOOK_URL=http://localhost:5678/webhook/nexus

# --- M-Pesa (Safaricom Daraja — sandbox keys are free) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.example.com/api/webhooks/mpesa
